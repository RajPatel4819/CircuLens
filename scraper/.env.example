# CircuLens Scraper Environment Variables
# Copy this file to .env and fill in your values

# Database
DB_HOST=localhost
DB_NAME=circulens
DB_USER=root
DB_PASS=

# Email (Gmail SMTP with App Password recommended)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_NAME=CircuLens

# Application
APP_URL=http://localhost/CircuLens
UPLOAD_DIR=../assets/uploads/

# Scraper
GTU_BASE_URL=https://www.gtu.ac.in
GTU_CIRCULAR_PATH=/circular.htm
REQUEST_TIMEOUT=30
MAX_CIRCULARS=50
